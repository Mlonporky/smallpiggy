[node name="EditablePig" type="Node2D" unique_id=401431594]
editor_description = "小猪静止装配工作台。展开 Pig，选择 Arm_A / Arm_B / Leg_A / Leg_B 调整位置、角度与图层。A/B 仅为部件编号，尚未对应角色自身左右。保存用 Cmd+S；F6 预览。"
texture_filter = 4

